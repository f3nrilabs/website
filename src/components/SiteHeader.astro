---
/**
 * Sticky pill navigation (docs/DESIGN.md, "SiteHeader").
 * Under 48rem the section links move into a <details> menu (no JavaScript needed).
 * On devices with a mouse, a spectrum light glides after the pointer across the bar: the only
 * script on the site, a progressive enhancement that does nothing on touch screens or
 * with reduced motion.
 */
import Button from "./Button.astro";
import Wordmark from "./Wordmark.astro";

type Section = "products" | "research" | "about";
interface Props {
  current?: Section | undefined;
}
const { current } = Astro.props;

const links: { id: Section; href: string; label: string }[] = [
  { id: "products", href: "/products", label: "Products" },
  { id: "research", href: "/research", label: "Research" },
  { id: "about", href: "/about", label: "About" },
];
const contact = "mailto:hello@f3nri.com";
---

<header class="site-header">
  <nav class="bar" aria-label="Main" data-spectrum>
    <span class="spectrum" aria-hidden="true">
      <span class="spectrum__glow"></span>
    </span>
    <a class="home" href="/" aria-label="f3nri home">
      <img src="/brand/mark-neon.svg" alt="" width="28" height="28" />
      <Wordmark size="sm" />
    </a>

    <ul class="links">
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="actions">
      <Button href={contact} size="sm">
        Contact us
      </Button>
      <details class="menu">
        <summary>Menu</summary>
        <ul class="menu__list">
          {links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))}
          <li class="menu__contact">
            <a href={contact}>Contact us</a>
          </li>
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  // Spectrum light: a soft band of colour, as tall as the bar, that follows the pointer and
  // stretches slightly with speed; the pill's rounded ends clip it into shape. It moves on a
  // slightly under-damped spring (a hint of overshoot, a natural settle), breathes at rest and
  // lands with a small bloom. Mouse only; skipped with reduced motion. The loop runs only
  // while the pointer is on the bar.
  const bar = document.querySelector<HTMLElement>("[data-spectrum]");
  const glow = bar?.querySelector<HTMLElement>(".spectrum__glow");
  const canHover = window.matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)");

  if (bar && glow && canHover.matches) {
    // Motion tokens (docs/DESIGN.md, "Motion"), read once. The fallbacks only fire if a
    // token is missing, which CI would catch as a visible glitch.
    const css = getComputedStyle(glow);
    const breath = Number.parseFloat(css.getPropertyValue("--spectrum-breath")) || 0.04;
    const breathPeriod =
      Number.parseFloat(css.getPropertyValue("--spectrum-breath-period")) || 3200;
    const bloom = Number.parseFloat(css.getPropertyValue("--spectrum-bloom")) || 0.3;

    // Spring: stiffness 170, damping 21 — just under critical, so the light settles
    // naturally instead of sliding linearly like a slider.
    const stiffness = 170;
    const damping = 21;
    let x = 0,
      tx = 0,
      vx = 0;
    let entered = 0;
    let last = performance.now();
    let frame = 0;

    const tick = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;

      const dx = tx - x;
      vx += (dx * stiffness - vx * damping) * dt;
      x += vx * dt;

      // Idle breath so the light never sits frozen; arrival bloom so it lands.
      const age = (now - entered) / 1000;
      const swell =
        1 +
        Math.sin((now / breathPeriod) * 2 * Math.PI) * breath -
        bloom * Math.exp(-7 * age) * Math.cos(10 * age);
      const stretch = 1 + Math.min(Math.abs(vx) / 200, 0.25);
      glow.style.transform = `translateX(${x}px) translateX(-50%) scaleX(${stretch * swell}) scaleY(${1 / Math.sqrt(swell)})`;
      frame =
        Math.abs(dx) > 0.3 || Math.abs(vx) > 0.3 || bar.matches(":hover")
          ? requestAnimationFrame(tick)
          : 0;
    };

    const aim = (event: PointerEvent) => {
      const box = bar.getBoundingClientRect();
      tx = event.clientX - box.left;
    };

    bar.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "mouse") return;
      aim(event);
      x = tx;
      vx = 0;
      entered = performance.now();
      bar.classList.add("is-lit");
      if (!frame) frame = requestAnimationFrame(tick);
    });
    bar.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse") return;
      aim(event);
      if (!frame) frame = requestAnimationFrame(tick);
    });
    bar.addEventListener("pointerleave", () => bar.classList.remove("is-lit"));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: var(--space-4);
    z-index: 10;
    height: var(--header-height);
    padding: 0 var(--gutter);
    box-sizing: border-box;
  }
  .bar {
    max-width: var(--content-max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    position: relative;
  }
  /* spectrum wave layer, clipped to the bar's pill shape */
  .spectrum {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
  }
  .spectrum__glow {
    position: absolute;
    /* full bar height (plus the blur, so its soft edge falls outside the clip): the pill's
       rounded ends then shape the light when it reaches them */
    left: 0;
    top: calc(-1 * var(--spectrum-blur));
    bottom: calc(-1 * var(--spectrum-blur));
    width: var(--spectrum-width);
    background: var(--spectrum-glow);
    filter: blur(var(--spectrum-blur));
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity var(--spectrum-fade) ease;
    will-change: transform;
  }
  .bar.is-lit .spectrum__glow {
    opacity: var(--spectrum-opacity);
    /* colours drift slowly inside the band, so the light is alive even at rest */
    animation: spectrum-shimmer var(--spectrum-shimmer-period) ease-in-out infinite alternate;
  }
  @keyframes spectrum-shimmer {
    from {
      filter: blur(var(--spectrum-blur)) hue-rotate(calc(var(--spectrum-shimmer) * -1));
    }
    to {
      filter: blur(var(--spectrum-blur)) hue-rotate(var(--spectrum-shimmer));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar.is-lit .spectrum__glow {
      animation: none;
    }
  }
  .bar > :not(.spectrum) {
    position: relative;
    z-index: 1;
  }
  .home {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }
  .home img {
    width: 1.75rem;
    height: 1.75rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links {
    display: flex;
    gap: var(--space-8);
  }
  .links a,
  .menu__list a {
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }
  .links a:hover,
  .menu__list a:hover,
  a[aria-current="page"] {
    color: var(--page-accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    cursor: pointer;
    font-weight: 600;
    font-size: var(--text-sm);
    padding: 0.625rem 1rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu__list {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-3));
    min-width: 12rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 48rem) {
    .links {
      display: none;
    }
    .menu {
      display: block;
    }
  }

  /* Phones narrower than ~368px: the contact pill moves into the menu so the mark,
     wordmark and menu fit on one line. The menu's contact link only shows here. */
  .menu__contact {
    display: none;
  }
  @media (max-width: 23rem) {
    .actions > :global(.btn) {
      display: none;
    }
    .menu__contact {
      display: list-item;
    }
  }
</style>
