---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import ColorBlock from "../components/ColorBlock.astro";
import Hero from "../components/Hero.astro";
import Pill from "../components/Pill.astro";
---

<Base>
  <Hero
    colorway="brand"
    titleSize="display"
    label="research · tools · intel"
    title={"Break the chain\nbefore it breaks you."}
  >
    <Fragment slot="lead">
      <p>
        f3nri is an independent security research team. We study threats, build the tools to catch
        them, and publish what we find.
      </p>
    </Fragment>
    <Fragment slot="actions">
      <Button variant="dark" href="/products/horus">
        Explore Horus
      </Button>
      <Button variant="ghost" href="mailto:hello@f3nri.com">
        Contact us
      </Button>
    </Fragment>
  </Hero>

  <section class="disciplines" aria-labelledby="disciplines-title">
    <div class="disciplines__head">
      <h2 id="disciplines-title">
        Three disciplines.
        <br />
        <span class="disciplines__accent">One team.</span>
      </h2>
      <p class="disciplines__lead">
        Everything we publish comes from the same loop: find it, prove it, ship something that
        catches it next time.
      </p>
    </div>

    <div class="disciplines__grid">
      <Card label="01 / research" title="Research">
        Threat analysis and write-ups on phishing, impersonation and the infrastructure behind them,
        with the evidence attached.
      </Card>
      <Card label="02 / tools" title="Tools">
        Software that turns what we learn into detection: monitoring, scanning and automation for
        security teams.
      </Card>
      <Card label="03 / intel" title="Intel">
        Indicators, patterns and context that defenders can act on, written plainly and published
        openly.
      </Card>
    </div>
  </section>

  <ColorBlock colorway="horus">
    <div class="horus__head">
      <Pill label="product 01 · in development · early access" />
      <h2 class="horus__title">Horus</h2>
      <p class="horus__lead">
        Catches typosquat, homoglyph and combosquat domains of your brand the moment their
        certificate is issued, before they go live.
      </p>
    </div>

    <div class="horus__grid">
      <Card onMedia label="watch" title="Certificate Transparency logs">
        Google, Cloudflare, Sectigo, DigiCert and Let's Encrypt logs, read as new certificates are
        written.
      </Card>
      <Card onMedia label="score" title="Lookalike scoring">
        Every new domain is scored against your brands for typosquats, homoglyphs and combosquats.
      </Card>
      <Card onMedia label="alert" title="Tracked until it bites">
        From certificate to DNS to live site to content match, with alerts by Telegram, email or
        webhook.
      </Card>
    </div>

    <div class="horus__actions">
      <Button variant="dark" href="/products/horus">
        See Horus
      </Button>
      <Button variant="ghost" href="mailto:hello@f3nri.com?subject=Horus%20early%20access">
        Request early access
      </Button>
    </div>
  </ColorBlock>

  <section class="lab" aria-labelledby="lab-title">
    <div class="lab__head">
      <h2 id="lab-title">From the lab</h2>
      <a class="lab__link" href="/research">
        All research →
      </a>
    </div>

    <!-- T-004 will replace this empty state with the latest three research posts. -->
    <div class="lab__empty">
      <p class="lab__command">
        <code>$ ls research/</code>
      </p>
      <p class="lab__line">The first write-ups are on the way.</p>
      <p class="lab__muted">Follow along on GitHub or X to read them first.</p>
    </div>
  </section>

  <ColorBlock colorway="dark" align="center">
    <h2 class="cta__title">Talk to us.</h2>
    <p class="cta__lead">
      Early access to Horus, research collaboration, or something you found. We read every message.
    </p>
    <Button variant="primary" href="mailto:hello@f3nri.com">
      hello@f3nri.com
    </Button>
  </ColorBlock>
</Base>

<style>
  .disciplines,
  .lab {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-24) var(--gutter);
  }
  .disciplines__head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: end;
    gap: var(--space-8);
  }
  .disciplines__accent {
    color: var(--accent);
  }
  .disciplines__lead {
    margin: 0;
    max-width: 34rem;
    color: var(--text-muted);
    font-size: var(--text-lg);
  }
  .disciplines__grid,
  .horus__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17.5rem, 1fr));
    gap: var(--space-6);
  }
  .disciplines__grid {
    margin-top: var(--space-12);
  }
  .horus__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }
  .horus__title {
    font-size: var(--text-giant);
  }
  .horus__lead {
    margin: 0;
    max-width: 34rem;
    color: var(--text-on-media);
    font-size: var(--text-lg);
  }
  .horus__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .lab__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .lab__head h2 {
    font-size: var(--text-section);
  }
  .lab__link {
    font-size: var(--text-lg);
  }
  .lab__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin-top: var(--space-12);
    padding: var(--space-12);
    background: var(--surface);
    border: thin dashed var(--border);
    border-radius: var(--radius-lg);
  }
  .lab__command,
  .lab__line,
  .lab__muted {
    margin: 0;
  }
  .lab__command {
    color: var(--accent);
    font-size: var(--text-sm);
  }
  .lab__line {
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .lab__muted {
    color: var(--text-muted);
  }
  .cta__title {
    font-size: var(--text-display);
  }
  .cta__lead {
    margin: 0;
    max-width: 34rem;
    color: var(--text-on-media);
    font-size: var(--text-lg);
  }

  @media (max-width: 48rem) {
    .disciplines,
    .lab {
      padding-block: var(--space-16);
    }
    .disciplines__head {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>
