---
/**
 * Sticky pill navigation (docs/DESIGN.md, "SiteHeader"). No JavaScript:
 * under 48rem the section links move into a <details> menu.
 */
import Button from "./Button.astro";
import Wordmark from "./Wordmark.astro";

type Section = "products" | "research" | "about";
interface Props {
  current?: Section | undefined;
}
const { current } = Astro.props;

const links: { id: Section; href: string; label: string }[] = [
  { id: "products", href: "/products", label: "Products" },
  { id: "research", href: "/research", label: "Research" },
  { id: "about", href: "/about", label: "About" },
];
const contact = "mailto:hello@f3nri.com";
---

<header class="site-header">
  <nav class="bar" aria-label="Main">
    <a class="home" href="/" aria-label="f3nri home">
      <img src="/brand/mark-neon.svg" alt="" width="28" height="28" />
      <Wordmark size="sm" />
    </a>

    <ul class="links">
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="actions">
      <Button href={contact} size="sm">
        Contact us
      </Button>
      <details class="menu">
        <summary>Menu</summary>
        <ul class="menu__list">
          {links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: var(--space-4);
    z-index: 10;
    height: var(--header-height);
    padding: 0 var(--gutter);
    box-sizing: border-box;
  }
  .bar {
    max-width: var(--content-max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .home {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }
  .home img {
    width: 1.75rem;
    height: 1.75rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links {
    display: flex;
    gap: var(--space-8);
  }
  .links a,
  .menu__list a {
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }
  .links a:hover,
  .menu__list a:hover,
  a[aria-current="page"] {
    color: var(--page-accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    cursor: pointer;
    font-weight: 600;
    font-size: var(--text-sm);
    padding: 0.625rem 1rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu__list {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-3));
    min-width: 12rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 48rem) {
    .links {
      display: none;
    }
    .menu {
      display: block;
    }
  }
</style>
