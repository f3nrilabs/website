---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { accentStyle, type Colorway } from "../lib/colorways";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Colorway of the page; product pages use the product's. */
  colorway?: Colorway;
  /** Highlights the matching link in the header. */
  current?: "products" | "research" | "about";
}

const {
  title,
  description = "f3nri is an independent security research team. research · tools · intel",
  image = "/og-image.png",
  colorway = "brand",
  current,
} = Astro.props;

const pageTitle = title ? `${title} · f3nri` : "f3nri — research · tools · intel";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0710" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/brand/mark-neon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="f3nri" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@f3nrilabs" />
  </head>
  <body style={accentStyle(colorway)}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader current={current} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -10rem;
    z-index: 20;
    padding: var(--space-3) var(--space-4);
    background: var(--text);
    color: var(--bg);
    border-radius: var(--radius-pill);
    font-weight: 600;
  }
  .skip-link:focus {
    top: var(--space-4);
  }
</style>
