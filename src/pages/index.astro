---
/*
 * Temporary home page: shows the shared header and footer from T-002.
 * Replaced by T-003 (.agents/tasks/T-003-home.md).
 */
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";
---

<Base>
  <section class="placeholder">
    <img src="/brand/mark-neon.svg" alt="" width="160" height="160" />
    <h1>
      <Wordmark size="hero" />
    </h1>
    <p class="tagline">research · tools · intel</p>
  </section>
</Base>

<style>
  .placeholder {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-16) var(--gutter);
    text-align: center;
  }
  .placeholder img {
    width: clamp(6rem, 18vw, 10rem);
    height: auto;
  }
  .placeholder h1 {
    text-transform: none;
  }
  .tagline {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--accent);
  }
</style>
