---
/**
 * The f3nri wordmark as live text: "f3nri" + accent underscore.
 * Never replace with an image of text, never change the font or letter spacing.
 * tone="ghost" is the large decorative footer version (Obsidian text, Amethyst underscore).
 */
interface Props {
  size?: "sm" | "md" | "hero" | "giant";
  tone?: "default" | "ghost";
}
const { size = "md", tone = "default" } = Astro.props;
---

<!-- prettier-ignore -->
<span class:list={["wordmark", `wordmark--${size}`, `wordmark--${tone}`]} aria-label="f3nri"><span aria-hidden="true">f3nri<span class="wordmark__cursor">_</span></span></span>

<style>
  .wordmark {
    font-family: var(--font-mono);
    font-weight: 800;
    letter-spacing: var(--tracking-wordmark);
    line-height: 1;
    color: var(--text);
    white-space: nowrap;
  }
  .wordmark__cursor {
    color: var(--accent);
  }
  .wordmark--ghost {
    color: var(--surface);
  }
  .wordmark--ghost .wordmark__cursor {
    color: var(--accent-strong);
  }
  .wordmark--sm {
    font-size: var(--text-xl);
  }
  .wordmark--md {
    font-size: var(--text-3xl);
  }
  .wordmark--hero {
    font-size: var(--text-hero);
  }
  .wordmark--giant {
    font-size: var(--text-giant);
    line-height: var(--leading-display);
    letter-spacing: -0.04em;
  }
</style>
