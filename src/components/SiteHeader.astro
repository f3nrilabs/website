---
/**
 * Sticky pill navigation (docs/DESIGN.md, "SiteHeader").
 * Under 48rem the section links move into a <details> menu (no JavaScript needed).
 * On devices with a mouse, a spectrum glow follows the pointer across the bar: the only
 * script on the site, a progressive enhancement that does nothing on touch screens or
 * with reduced motion.
 */
import Button from "./Button.astro";
import Wordmark from "./Wordmark.astro";

type Section = "products" | "research" | "about";
interface Props {
  current?: Section | undefined;
}
const { current } = Astro.props;

const links: { id: Section; href: string; label: string }[] = [
  { id: "products", href: "/products", label: "Products" },
  { id: "research", href: "/research", label: "Research" },
  { id: "about", href: "/about", label: "About" },
];
const contact = "mailto:hello@f3nri.com";
---

<header class="site-header">
  <nav class="bar" aria-label="Main" data-spectrum>
    <span class="spectrum" aria-hidden="true">
      <span class="spectrum__ring"></span>
      <span class="spectrum__ring spectrum__ring--b"></span>
    </span>
    <a class="home" href="/" aria-label="f3nri home">
      <img src="/brand/mark-neon.svg" alt="" width="28" height="28" />
      <Wordmark size="sm" />
    </a>

    <ul class="links">
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="actions">
      <Button href={contact} size="sm">
        Contact us
      </Button>
      <details class="menu">
        <summary>Menu</summary>
        <ul class="menu__list">
          {links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))}
          <li class="menu__contact">
            <a href={contact}>Contact us</a>
          </li>
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  const bar = document.querySelector<HTMLElement>("[data-spectrum]");
  const canHover = window.matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)");
  if (bar && canHover.matches) {
    bar.addEventListener("pointermove", (event) => {
      const box = bar.getBoundingClientRect();
      bar.style.setProperty("--mx", `${event.clientX - box.left}px`);
      bar.style.setProperty("--my", `${event.clientY - box.top}px`);
      bar.dataset.lit = "";
    });
    bar.addEventListener("pointerleave", () => {
      delete bar.dataset.lit;
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: var(--space-4);
    z-index: 10;
    height: var(--header-height);
    padding: 0 var(--gutter);
    box-sizing: border-box;
  }
  .bar {
    max-width: var(--content-max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    position: relative;
  }
  /* spectrum: rippling colour rings around the pointer (docs/DESIGN.md, "SiteHeader") */
  .spectrum {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }
  .bar[data-lit] .spectrum {
    opacity: 1;
  }
  .spectrum__ring {
    position: absolute;
    left: var(--mx, 50%);
    top: var(--my, 50%);
    width: var(--spectrum-size);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--spectrum);
    -webkit-mask: var(--spectrum-mask);
    mask: var(--spectrum-mask);
    filter: blur(3px) saturate(1.2);
    transform: translate(-50%, -50%);
    transition:
      left 90ms var(--ease-out),
      top 90ms var(--ease-out);
    animation:
      spectrum-spin 2.4s linear infinite,
      spectrum-breathe 1.6s ease-in-out infinite alternate;
  }
  .spectrum__ring--b {
    width: calc(var(--spectrum-size) * 1.45);
    animation-direction: reverse, alternate-reverse;
    animation-duration: 1.7s, 1.2s;
    opacity: 0.55;
    filter: blur(8px) saturate(1.2);
    transition:
      left 220ms var(--ease-out),
      top 220ms var(--ease-out);
  }
  @keyframes spectrum-spin {
    to {
      rotate: 1turn;
    }
  }
  @keyframes spectrum-breathe {
    from {
      scale: 0.88;
    }
    to {
      scale: 1.08;
    }
  }
  .bar > :not(.spectrum) {
    position: relative;
    z-index: 1;
  }
  .home {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }
  .home img {
    width: 1.75rem;
    height: 1.75rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links {
    display: flex;
    gap: var(--space-8);
  }
  .links a,
  .menu__list a {
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }
  .links a:hover,
  .menu__list a:hover,
  a[aria-current="page"] {
    color: var(--page-accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    cursor: pointer;
    font-weight: 600;
    font-size: var(--text-sm);
    padding: 0.625rem 1rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu__list {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-3));
    min-width: 12rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 48rem) {
    .links {
      display: none;
    }
    .menu {
      display: block;
    }
  }

  /* Phones narrower than ~368px: the contact pill moves into the menu so the mark,
     wordmark and menu fit on one line. The menu's contact link only shows here. */
  .menu__contact {
    display: none;
  }
  @media (max-width: 23rem) {
    .actions > :global(.btn) {
      display: none;
    }
    .menu__contact {
      display: list-item;
    }
  }
</style>
